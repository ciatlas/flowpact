{
  "name": "flowpact-monorepo",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "flowpact": "node packages/cli/dist/index.js",
    "docs:gen": "tsx --conditions=source scripts/gen-rule-docs.ts && tsx --conditions=source scripts/gen-schemas.ts",
    "docs:screenshots": "pnpm build && tsx scripts/gen-screenshots.ts",
    "docs:dev": "pnpm docs:gen && pnpm --filter docs dev",
    "docs:build": "pnpm docs:gen && pnpm --filter docs build",
    "docs:check": "tsx --conditions=source scripts/check-links.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@flowpact/core": "workspace:*",
    "@flowpact/lint": "workspace:*",
    "@flowpact/reporters": "workspace:*",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
