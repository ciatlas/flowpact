    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schemas": {
          "type": "object",
          "properties": {
            "config": {
              "type": "number"
            },
            "contract": {
              "type": "number"
            },
            "report": {
              "type": "number"
            }
          },
          "required": [
            "config",
            "contract",
            "report"
          ],
          "additionalProperties": false
        },
        "node": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "root": {
          "type": "string"
