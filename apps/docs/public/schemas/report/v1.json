              "level": {
                "type": "string",
                "enum": [
                  "none",
                  "patch",
                  "minor",
                  "major"
                ]
              },
              "certain": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "loc": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endLine": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endColumn": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "file",
                  "line",
                  "column",
                  "endLine",
                  "endColumn"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "unit",
              "kind",
              "level",
              "certain",
              "message",
              "loc"
            ],
            "additionalProperties": false
          }
        },
        "scope": {
          "description": "Only when paths were given: impact mode graded only the published units within them, and the verdict is about those alone.",
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The paths given, relative to the root."
            },
            "units": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The published workflows and actions within them, in the baseline or the working tree: the only ones graded."
            }
          },
          "required": [
            "paths",
            "units"
          ],
          "additionalProperties": false
        },
        "ignored": {
          "description": "Only when `ignore` left out published workflows or actions (within the paths): those units, which were not graded, as both the baseline's and the pull request's `ignore` match them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "baseline",
        "required",
        "ok",
        "changes"
