              "unit": {
                "type": "string"
              },
              "invalid": {
                "type": "string"
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "breaking": {
                      "type": "boolean"
                    },
                    "path": {
                      "type": "string"
