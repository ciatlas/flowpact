{
  "name": "@flowpact/reporters",
  "version": "0.12.3",
  "private": true,
  "description": "Output formatters for flowpact analysis results (pretty terminal, JSON).",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node22",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ciatlas/core": "github:ciatlas/core#v0.1.0",
    "@flowpact/lint": "workspace:*",
    "picocolors": "^1.1.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
