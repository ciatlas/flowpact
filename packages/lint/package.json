{
  "name": "@flowpact/lint",
  "version": "0.12.2",
  "private": true,
  "description": "flowpact's checks on the workflow model: rules, config, contracts, impact mode and reports.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node22",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ciatlas/core": "github:ciatlas/core#v0.1.0",
    "diff": "^9.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
