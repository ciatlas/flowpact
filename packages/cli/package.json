{
  "name": "flowpact",
  "version": "0.13.0",
  "description": "Data-flow linter for GitHub Actions: finds inputs, secrets and matrix values that arrive empty across reusable workflows and local actions.",
  "keywords": [
    "github-actions",
    "linter",
    "reusable-workflows",
    "workflow-call",
    "composite-actions",
    "matrix",
    "secrets",
    "static-analysis",
    "ci",
    "sarif",
    "semver",
    "contracts"
  ],
  "homepage": "https://ciatlas.github.io/flowpact",
  "bugs": {
    "url": "https://github.com/ciatlas/flowpact/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciatlas/flowpact.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Ruman Kazi",
  "type": "module",
  "bin": {
    "flowpact": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/api.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@ciatlas/core": "github:ciatlas/core#v0.3.0",
    "@flowpact/lint": "workspace:*",
    "@flowpact/language-server": "workspace:*",
    "@flowpact/reporters": "workspace:*",
    "@vercel/ncc": "^0.45.0",
    "citty": "^0.2.2",
    "esbuild": "^0.28.2",
    "execa": "^10.1.0",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1"
  }
}
